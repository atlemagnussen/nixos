# ---- fetch & verify ----
FROM debian:trixie-slim AS fetch
ARG version=32.1
ARG arch=x86_64-linux-gnu
# minimum number of good builder signatures on SHA256SUMS
ARG min_sigs=3

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget gnupg git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/btc
RUN set -eux; \
  base=https://bitcoincore.org/bin/bitcoin-core-${version}; \
  wget -q $base/bitcoin-${version}-${arch}.tar.gz $base/SHA256SUMS $base/SHA256SUMS.asc; \
  sha256sum --ignore-missing --check SHA256SUMS; \
  git clone --depth 1 https://github.com/bitcoin-core/guix.sigs /tmp/sigs; \
  gpg --batch --import /tmp/sigs/builder-keys/*.gpg 2>/dev/null || true; \
  good=$(gpg --batch --status-fd 1 --verify SHA256SUMS.asc SHA256SUMS 2>/dev/null | grep -c '^\[GNUPG:\] GOODSIG' || true); \
  echo "good signatures: $good"; \
  [ "$good" -ge "$min_sigs" ]; \
  tar xzf bitcoin-${version}-${arch}.tar.gz; \
  mv bitcoin-${version} /opt/bitcoin

# ---- runtime ----
FROM debian:trixie-slim
ARG version=32.1
ARG datadir=/home/bitcoin/.bitcoin
ARG UID=1001
ARG GID=1001

ENV BITCOIN_VERSION=$version \
    BITCOIN_DATA=$datadir

COPY --from=fetch /opt/bitcoin/bin/bitcoind /opt/bitcoin/bin/bitcoin-cli /usr/local/bin/

RUN groupadd --gid ${GID} bitcoin \
  && useradd --create-home --no-log-init -u ${UID} -g ${GID} bitcoin \
  && mkdir -p "${BITCOIN_DATA}" \
  && chown bitcoin:bitcoin "${BITCOIN_DATA}" \
  && chmod 770 "${BITCOIN_DATA}"

USER bitcoin
VOLUME ["${BITCOIN_DATA}"]
EXPOSE 8332 8333

RUN bitcoind -version | grep -E "version v${BITCOIN_VERSION}(\.0)?( |$)"
STOPSIGNAL SIGTERM
CMD ["bitcoind"]
