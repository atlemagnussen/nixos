FROM pytorch/pytorch:2.2.1-cuda12.1-cudnn8-runtime

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libmagic1 \
    poppler-utils \
    tesseract-ocr \
    libtesseract-dev \
    git \
    ffmpeg \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install FastAPI and uvicorn for the API server
RUN pip install --no-cache-dir \
    marker-pdf[full] \
    uvicorn \
    fastapi \
    python-multipart

WORKDIR /data

# Expose the API port
EXPOSE 8000

# Set environment to use GPU
ENV TORCH_DEVICE=cuda

# Start the marker API server
ENTRYPOINT ["marker_server", "--port", "8000", "--host", "0.0.0.0"]
