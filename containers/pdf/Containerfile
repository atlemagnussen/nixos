FROM pytorch/pytorch:2.2.1-cuda12.1-cudnn8-runtime

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libmagic1 \
    poppler-utils \
    tesseract-ocr \
    libtesseract-dev \
    git \
    ffmpeg \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install compatible versions
RUN pip install --upgrade pip setuptools wheel

# Install PyTorch ecosystem with compatible versions
RUN pip install --no-cache-dir \
    torch==2.2.1 \
    torchvision==0.17.1 \
    torchaudio==2.2.1

# Install transformers with compatible version
RUN pip install --no-cache-dir \
    transformers==4.40.0 \
    pillow>=10.0.0

# Install marker and its dependencies
RUN pip install --no-cache-dir \
    marker-pdf[full]

# Install FastAPI and uvicorn for the API server
RUN pip install --no-cache-dir \
    uvicorn \
    fastapi \
    python-multipart

WORKDIR /data

# Expose the API port
EXPOSE 8000

# Set environment to use GPU
ENV TORCH_DEVICE=cuda

# Start the marker API server
ENTRYPOINT ["marker_server", "--port", "8000", "--host", "0.0.0.0"]
